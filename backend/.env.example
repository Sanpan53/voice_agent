# ============================================================
# voice_agent 环境变量样例
# 复制为 .env 后填写真实值；所有密钥/凭据只能通过环境变量注入。
# 说明：DB_HOST / REDIS_HOST 为示例地址，仅作占位，生产请替换。
# ============================================================

# ---- 应用 ----
APP_NAME=voice_agent
APP_HOST=0.0.0.0
APP_PORT=8080
APP_ENV=development
APP_VERSION=0.1.0

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=voice_agent
DB_USER=voice_agent
DB_PASSWORD=

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=3

# ---- 缓存 ----
CACHE_TTL_SECONDS=1800
CACHE_NULL_VALUES=false
CACHE_KEY_PREFIX=voice_agent:cache:

# ---- DashScope（对应 agentscope.dashscope.api-key） ----
DASHSCOPE_API_KEY=
MAIN_MODEL=qwen-max
LIGHT_MODEL=qwen-flash
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024
ASR_MODEL=paraformer-realtime-v2
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longxiaochun_v3

# ---- 会话（对应 voice_agent.session） ----
SESSION_TTL_MINUTES=30
SESSION_MAX_HISTORY_TURNS=10

# ---- JWT ----
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_SECONDS=2592000

# ---- 成本控制 ----
# Embedding 缓存有效期（秒），默认 7 天
EMBEDDING_CACHE_TTL_SECONDS=604800
EMBEDDING_CACHE_KEY_PREFIX=voice_agent:embed:
# Agent 记忆巡检周期（秒）
MEMORY_GUARD_INTERVAL_SECONDS=60
# 启动时是否预热 TTS 短语缓存。默认 false——预热会真的调 DashScope，
# 失败会拖慢启动；需要就开，或调 POST /api/v1/debug/tts-cache/preload 手工预热。
TTS_PHRASE_PRELOAD_ON_STARTUP=false

# ---- 合规（对应 voice_agent.compliance） ----
SENSITIVE_WORD_FILE=app/resources/compliance/sensitive-words.txt
ABSOLUTE_CLAIM_PATTERNS=最好,第一,保证,绝对
